# =============================================================================
# Lakehouse configuration — the complete set of "definable variables".
# Copy to .env for local/compose dev (values below are the dev defaults, so an
# empty .env works). For K8s, these map to the Helm chart's values.yaml:
#   - non-secret knobs  -> ConfigMap (templates/configmap.yaml)
#   - [SECRET] rows     -> K8s Secret (templates/secret.yaml)
# The code reads every value via env (kaist_ingestion/config.py, nvidia_ingestion/
# config.py); defaults keep local dev working unchanged.
# =============================================================================

# --- Object store (MinIO / S3) — where Iceberg metadata + materialized data live -
AWS_S3_ENDPOINT=http://minio:9000        # K8s: http://minio.lakehouse.svc:9000  (or external S3)
AWS_ACCESS_KEY_ID=minioadmin             # [SECRET]
AWS_SECRET_ACCESS_KEY=minioadmin         # [SECRET]
AWS_REGION=us-east-1
S3_BUCKET=warehouse

# --- Iceberg REST catalog (Polaris) ------------------------------------------
POLARIS_URI=http://polaris:8181/api/catalog   # K8s: http://polaris.lakehouse.svc:8181/api/catalog
POLARIS_CATALOG_NAME=lakehouse_catalog
POLARIS_CREDENTIAL=root:s3cr3t           # [SECRET] client_id:client_secret
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL
# POLARIS_OAUTH2_SERVER_URI=              # defaults to ${POLARIS_URI}/v1/oauth/tokens

# --- Polaris backing store (Postgres) + bootstrap (compose/helm infra) --------
POLARIS_PG_USER=polaris                   # [SECRET]
POLARIS_PG_PASSWORD=polaris               # [SECRET]
POLARIS_PG_DB=polaris
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root               # [SECRET]
POLARIS_ROOT_CLIENT_SECRET=s3cr3t         # [SECRET]
MINIO_ROOT_USER=minioadmin                # [SECRET]
MINIO_ROOT_PASSWORD=minioadmin            # [SECRET]

# --- Spark -------------------------------------------------------------------
SPARK_CATALOG_NAME=iceberg
SPARK_DRIVER_MEMORY=32g

# --- Dataset source paths (register-in-place -> STABLE mount paths) ----------
# KAIST is the sibling dataset variant sharing this base config; set only if used.
KAIST_SOURCE_PATH=/user_data/kaist-simulated

# --- Dataset ingestion (NVIDIA PhysicalAI) -----------------------------------
# Raw data location. Local/compose: the NFS mount; K8s: the PVC mount path where
# the uploaded SSD data lives (register-in-place -> must be a STABLE path).
NVIDIA_SOURCE_PATH=/mnt/netai-e2e/nvidia-physicalai-av-subset
NVIDIA_NS_BRONZE=nvidia_bronze
NVIDIA_NS_SILVER=nvidia_silver
NVIDIA_NS_GOLD=nvidia_gold
NVIDIA_LIDAR_MODE=blob                     # blob | decoded
NVIDIA_SILVER_MODE=view                    # view | inplace
NVIDIA_GOLD_MODE=materialized              # materialized | view
